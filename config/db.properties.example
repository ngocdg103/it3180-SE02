# BlueMoon Database Configuration Template
# Copy this file to config/db.properties and fill in your actual credentials.

# MySQL Connector/J is discovered automatically by JDBC.
db.url=
db.username=
db.password=

# Set values locally; never commit credentials.
# BLUEMOON_DB_CONFIG selects another file path.
# BLUEMOON_DB_URL, BLUEMOON_DB_USERNAME and BLUEMOON_DB_PASSWORD
# override individual properties. Connections are not pooled.

