<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<!-- Night sky over the city skyline (CSS background, images/login-skyline.png); the moon mark and
     brand sit in the sky, the sign-in form is a warm-white card in front. -->
<StackPane xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.bluemoon.controllers.LoginController"
           stylesheets="@bluemoon-theme.css" styleClass="bm-login, bm-ui">
    <HBox alignment="CENTER" spacing="56" styleClass="bm-login-content">
        <VBox styleClass="bm-login-brand" spacing="14" maxWidth="400" minWidth="0" maxHeight="-Infinity" HBox.hgrow="SOMETIMES">
            <Region styleClass="bm-moon, large"/>
            <Label text="BlueMoon" styleClass="bm-login-brand-name"/>
            <Label text="Quản lý hồ sơ cư dân và thu phí cho chung cư BlueMoon." wrapText="true"
                   styleClass="bm-login-brand-text"/>
        </VBox>
        <VBox alignment="CENTER_LEFT" spacing="10" prefWidth="420" maxWidth="420" minWidth="300" maxHeight="-Infinity"
              styleClass="card, bm-login-card">
            <Label text="Đăng nhập" styleClass="bm-title"/>
            <Label text="Dùng tài khoản do Ban quản lý cấp." styleClass="bm-muted" wrapText="true"/>
            <Region minHeight="10"/>
            <Label text="Tên đăng nhập" labelFor="$username" styleClass="bm-field-label"/>
            <TextField fx:id="username" promptText="Ví dụ: ketoan01" onAction="#login"/>
            <Label text="Mật khẩu" labelFor="$password" styleClass="bm-field-label"/>
            <PasswordField fx:id="password" promptText="Nhập mật khẩu" onAction="#login"/>
            <Region minHeight="8"/>
            <Button fx:id="loginButton" text="Đăng nhập" onAction="#login" defaultButton="true" maxWidth="Infinity"
                    styleClass="bm-btn-primary"/>
            <Label fx:id="status" wrapText="true" minHeight="52" maxWidth="340" styleClass="status, bm-login-status"/>
        </VBox>
    </HBox>
</StackPane>
