<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<BorderPane xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.bluemoon.controllers.DashboardController"
            stylesheets="@bluemoon-theme.css" styleClass="bm-app">
    <left><VBox fx:id="sidebar" styleClass="bm-sidebar, bm-ui" prefWidth="256" minWidth="210">
        <HBox alignment="CENTER_LEFT" spacing="10" style="-fx-padding: 0 8 20 8;">
            <Region styleClass="bm-moon"/>
            <VBox>
                <Label text="BlueMoon" styleClass="bm-brand"/>
                <Label text="Quản lý chung cư" styleClass="bm-brand-sub"/>
            </VBox>
        </HBox>
        <!-- Group headers and module buttons are appended by DashboardController (RBAC-filtered). -->
        <ScrollPane fitToWidth="true" hbarPolicy="NEVER" VBox.vgrow="ALWAYS" styleClass="bm-nav-scroll">
            <content><VBox fx:id="moduleMenu" spacing="4">
                <Button fx:id="homeButton" text="Tổng quan" maxWidth="Infinity" onAction="#showHome" styleClass="bm-nav-item"/>
            </VBox></content>
        </ScrollPane>
    </VBox></left>
    <center><BorderPane>
        <top><HBox styleClass="bm-topbar, bm-ui">
            <VBox spacing="2" HBox.hgrow="ALWAYS" minWidth="0">
                <Label text="BlueMoon / Bảng điều khiển" styleClass="bm-breadcrumb"/>
                <Label fx:id="pageTitle" text="Tổng quan" styleClass="bm-page-title"/>
            </VBox>
            <HBox spacing="10" alignment="CENTER_LEFT" minWidth="-Infinity" maxHeight="-Infinity" styleClass="bm-user">
                <StackPane styleClass="bm-avatar"><Label fx:id="avatar"/></StackPane>
                <VBox spacing="0" minWidth="0">
                    <Label fx:id="greeting" styleClass="bm-user-name"/>
                    <Label fx:id="role" styleClass="bm-user-role"/>
                </VBox>
            </HBox>
            <Button fx:id="logoutButton" text="Đăng xuất" onAction="#logout" styleClass="bm-btn-ghost" minWidth="-Infinity"/>
        </HBox></top>
        <center><ScrollPane fitToWidth="true" fitToHeight="true" styleClass="bm-content-scroll">
            <content><StackPane fx:id="moduleContent" styleClass="bm-module-host"/></content>
        </ScrollPane></center>
        <bottom><Label fx:id="shellStatus" wrapText="true" maxWidth="Infinity" styleClass="status, bm-statusbar"/></bottom>
    </BorderPane></center>
</BorderPane>
