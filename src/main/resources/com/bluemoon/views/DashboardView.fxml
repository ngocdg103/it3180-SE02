<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<BorderPane xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.bluemoon.controllers.DashboardController"
            stylesheets="@auth.css" styleClass="page">
    <top><VBox spacing="8" styleClass="card">
        <Label text="BlueMoon" styleClass="brand"/>
        <HBox spacing="18" alignment="CENTER_LEFT">
            <VBox spacing="4" HBox.hgrow="ALWAYS"><Label fx:id="greeting" wrapText="true"/><Label fx:id="role"/></VBox>
            <Button fx:id="logoutButton" text="Đăng xuất" onAction="#logout"/>
        </HBox>
    </VBox></top>
    <left><VBox fx:id="moduleMenu" spacing="12" prefWidth="190" style="-fx-padding: 16 12 0 0;">
        <Button fx:id="homeButton" text="Tổng quan" maxWidth="Infinity" onAction="#showHome"/>
    </VBox></left>
    <center><ScrollPane fitToWidth="true" fitToHeight="true" style="-fx-padding: 16 0 0 0;">
        <content><StackPane fx:id="moduleContent"/></content>
    </ScrollPane></center>
    <bottom><Label fx:id="shellStatus" wrapText="true" styleClass="status"/></bottom>
</BorderPane>
